# Database Configuration
DATABASE_URL=postgresql://meetup_user:meetup_password@postgres:5432/meetup_db

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Maps API Key (required for geocoding event locations)
# Get your API key at: https://console.cloud.google.com/google/maps-apis
# Enable these APIs: Geocoding API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
